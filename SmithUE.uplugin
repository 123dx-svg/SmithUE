	"FriendlyName": "SmithUE",
	"Description": "Full-stack AI tool service plugin for Unreal Engine 5.8 - exposes 314 editor automation tools via HTTP JSON (incl. AI: blackboard/behavior-tree/EQS/state-tree authoring, PCG graph authoring + generation stats, static-mesh collision/Nanite/LOD build, Unreal Insights trace capture/analysis, modal-dialog detect/respond), with AI texture/audio generation (Pollinations.ai)",
	"Category": "Editor",
	"CreatedBy": "123dx-svg",
	"CreatedByURL": "https://github.com/123dx-svg/SmithUE",
	"DocsURL": "https://github.com/123dx-svg/SmithUE#readme",
	"MarketplaceURL": "",
	"SupportURL": "https://github.com/123dx-svg/SmithUE/issues",
	"CanContainContent": false,
	"IsBetaVersion": true,
	"IsExperimentalVersion": false,
	"Installed": false,
	"Modules": [
		{
			"Name": "SmithUE",
			"Type": "Editor",
			"LoadingPhase": "Default",
			"PlatformAllowList": [
				"Win64",
				"Mac",
				"Linux"
			]
		}
	],
